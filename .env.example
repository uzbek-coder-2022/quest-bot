# Telegram bot token from BotFather
BOT_TOKEN=replace-me

# One or more numeric Telegram user IDs, comma-separated
SUPERADMIN_IDS=123456789

# PostgreSQL URL. URL-encode special characters in the username/password.
DATABASE_URL=postgresql://quest_bot:change-this-password@127.0.0.1:5432/quest_bot
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
SCHEDULER_INTERVAL_SECONDS=10
BACKUP_UPLOAD_TIMEOUT_SECONDS=900
SERVICE_STOP_TIMEOUT_SECONDS=1800

# Local-development fallback only: leave DATABASE_URL empty to use SQLite.
# DATABASE_PATH=data/quest_bot.sqlite3
